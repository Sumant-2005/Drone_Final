Model {
  Name "DroneFlight"
  Version 8.0
  SavedCharacterEncoding "UTF-8"
  SolverType "Fixed-step"
  Solver "FixedStepDiscrete"
  FixedStep "df_p.step_s"
  StopTime "9"
  InitFcn "df_init;"
  ReturnWorkspaceOutputs on
  System {
    Location [20, 60, 1200, 700]
    Block {
      BlockType SubSystem
      Name "Movement command"
      Position [20, 90, 153, 154]
      System {
        Location [20, 60, 1200, 700]
        Block {
          BlockType FromWorkspace
          Name "Forward speed command"
          Position [25, 28, 180, 62]
          VariableName "df_forward"
          Interpolate "off"
          SampleTime "df_p.step_s"
        }
        Block {
          BlockType FromWorkspace
          Name "Other mission channels"
          Position [25, 130, 180, 164]
          VariableName "df_aux"
          Interpolate "off"
          SampleTime "df_p.step_s"
        }
        Block {
          BlockType Mux
          Name "Collect commands"
          Position [240, 30, 250, 155]
          Inputs "2"
        }
        Block {
          BlockType Outport
          Name "commands"
          Position [340, 80, 380, 100]
          Port "1"
        }
        Line {
          SrcBlock "Forward speed command"
          SrcPort 1
          Name "Forward speed (m per s)"
          DstBlock "Collect commands"
          DstPort 1
        }
        Line {
          SrcBlock "Other mission channels"
          SrcPort 1
          DstBlock "Collect commands"
          DstPort 2
        }
        Line {
          SrcBlock "Collect commands"
          SrcPort 1
          DstBlock "commands"
          DstPort 1
        }
      }
    }
    Block {
      BlockType SubSystem
      Name "Flight controller"
      Position [212, 90, 337, 154]
      System {
        Location [20, 60, 1200, 700]
        Block {
          BlockType Inport
          Name "commands"
          Position [25, 38, 65, 58]
          Port "1"
        }
        Block {
          BlockType Inport
          Name "state"
          Position [25, 108, 65, 128]
          Port "2"
        }
        Block {
          BlockType Mux
          Name "Reference and feedback"
          Position [130, 30, 140, 140]
          Inputs "2"
        }
        Block {
          BlockType MATLABFcn
          Name "Velocity and height control"
          Position [212, 48, 370, 82]
          MATLABFcn "df_velocity(u,df_p)"
          OutputDimensions "4"
        }
        Block {
          BlockType Mux
          Name "Demands and state"
          Position [468, 40, 478, 145]
          Inputs "2"
        }
        Block {
          BlockType MATLABFcn
          Name "Attitude and body rate control"
          Position [565, 66, 723, 100]
          MATLABFcn "df_moments(u,df_p)"
          OutputDimensions "4"
        }
        Block {
          BlockType Outport
          Name "requested loads"
          Position [814, 73, 854, 93]
          Port "1"
        }
        Line {
          SrcBlock "commands"
          SrcPort 1
          DstBlock "Reference and feedback"
          DstPort 1
        }
        Line {
          SrcBlock "state"
          SrcPort 1
          Branch {
            DstBlock "Reference and feedback"
            DstPort 2
          }
          Branch {
            DstBlock "Demands and state"
            DstPort 2
          }
        }
        Line {
          SrcBlock "Reference and feedback"
          SrcPort 1
          DstBlock "Velocity and height control"
          DstPort 1
        }
        Line {
          SrcBlock "Velocity and height control"
          SrcPort 1
          DstBlock "Demands and state"
          DstPort 1
        }
        Line {
          SrcBlock "Demands and state"
          SrcPort 1
          DstBlock "Attitude and body rate control"
          DstPort 1
        }
        Line {
          SrcBlock "Attitude and body rate control"
          SrcPort 1
          DstBlock "requested loads"
          DstPort 1
        }
      }
    }
    Block {
      BlockType SubSystem
      Name "Quad X mixer"
      Position [393, 90, 509, 154]
      System {
        Location [20, 60, 1200, 700]
        Block {
          BlockType Inport
          Name "requested loads"
          Position [20, 75, 60, 95]
          Port "1"
        }
        Block {
          BlockType Gain
          Name "Inverse allocation matrix"
          Position [140, 63, 300, 110]
          Gain "df_p.allocation"
          Multiplication "Matrix(K*u)"
        }
        Block {
          BlockType MATLABFcn
          Name "Rotor thrust limits"
          Position [370, 66, 528, 100]
          MATLABFcn "df_limit(u,df_p)"
          OutputDimensions "4"
        }
        Block {
          BlockType Outport
          Name "motor thrusts"
          Position [560, 75, 600, 95]
          Port "1"
        }
        Line {
          SrcBlock "requested loads"
          SrcPort 1
          DstBlock "Inverse allocation matrix"
          DstPort 1
        }
        Line {
          SrcBlock "Inverse allocation matrix"
          SrcPort 1
          DstBlock "Rotor thrust limits"
          DstPort 1
        }
        Line {
          SrcBlock "Rotor thrust limits"
          SrcPort 1
          DstBlock "motor thrusts"
          DstPort 1
        }
      }
    }
    Block {
      BlockType SubSystem
      Name "Thrust to speed"
      Position [575, 90, 699, 154]
      System {
        Location [20, 60, 1200, 700]
        Block {
          BlockType Inport
          Name "motor thrusts"
          Position [20, 80, 60, 100]
          Port "1"
        }
        Block {
          BlockType Gain
          Name "Inverse thrust coefficient"
          Position [140, 66, 300, 114]
          Gain "1/df_p.kT"
        }
        Block {
          BlockType Sqrt
          Name "Square root"
          Position [370, 66, 473, 114]
        }
        Block {
          BlockType Outport
          Name "speed references"
          Position [550, 80, 590, 100]
          Port "1"
        }
        Line {
          SrcBlock "motor thrusts"
          SrcPort 1
          DstBlock "Inverse thrust coefficient"
          DstPort 1
        }
        Line {
          SrcBlock "Inverse thrust coefficient"
          SrcPort 1
          DstBlock "Square root"
          DstPort 1
        }
        Line {
          SrcBlock "Square root"
          SrcPort 1
          DstBlock "speed references"
          DstPort 1
        }
      }
    }
    Block {
      BlockType SubSystem
      Name "Rotors and body"
      Position [763, 90, 897, 154]
      System {
        Location [20, 60, 1200, 700]
        Block {
          BlockType Inport
          Name "speed references"
          Position [25, 140, 65, 160]
          Port "1"
        }
        Block {
          BlockType UnitDelay
          Name "Body and rotor state"
          Position [30, 36, 158, 80]
          InitialCondition "df_p.x0"
          SampleTime "df_p.step_s"
        }
        Block {
          BlockType Mux
          Name "State and references"
          Position [235, 30, 245, 180]
