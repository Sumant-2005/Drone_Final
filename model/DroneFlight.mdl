          Branch {
            DstBlock "State and references"
            DstPort 1
          }
        }
        Line {
          SrcBlock "speed references"
          SrcPort 1
          DstBlock "State and references"
          DstPort 2
        }
        Line {
          SrcBlock "State and references"
          SrcPort 1
          DstBlock "Rigid body RK4 step"
          DstPort 1
        }
        Line {
          SrcBlock "Rigid body RK4 step"
          SrcPort 1
          DstBlock "Body and rotor state"
          DstPort 1
        }
      }
    }
    Block {
