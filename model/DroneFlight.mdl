        }
        Block {
          BlockType Demux
          Name "Four speed references - rpm channels"
          Position [415, 745, 425, 809]
          Outputs "4"
        }
        Block {
          BlockType Scope
          Name "Four speed references - rpm"
          Position [635, 745, 760, 815]
          NumInputPorts "4"
          OpenAtSimulationStart "off"
        }
        Line {
          SrcBlock "Read state"
          SrcPort 1
          DstBlock "Flight measurements"
          DstPort 1
        }
        Line {
          SrcBlock "Read command"
          SrcPort 1
          Branch {
            DstBlock "Command fields"
            DstPort 1
          }
          Branch {
            DstBlock "Log commandLog"
            DstPort 1
